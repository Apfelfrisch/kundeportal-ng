APP_NAME=Kundenportal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# White-label tenant: voltaik-check | friesen-werk
CLIENT=voltaik-check

# Base URL of the TanStack Start SPA (signed mail links point here).
FRONTEND_URL=http://localhost:3000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kundenportal
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:3000,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="portal@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# KVS / Pebs customer-data-api (contract master data).
CUSTOMER_DATA_API_URL=
CUSTOMER_DATA_API_ROOT=
# Personal access token from the KVS personal_access_tokens table.
CUSTOMER_DATA_API_TOKEN=

# Link target to open a contract in the KVS backoffice (admin UI).
KVS_APP_URL=

# S3 storage holding the Pebs invoice/contract PDFs (MinIO in dev).
CUSTOMER_API_S3_KEY=kundenportal
CUSTOMER_API_S3_SECRET=secretsecret
CUSTOMER_API_S3_BUCKET=customer-api
CUSTOMER_API_S3_ENDPOINT=http://localhost:9000

# Market-partner spot price API (dynamic tariff tenants).
MARKETPARTNER_API_URL=
MARKETPARTNER_API_TOKEN=
