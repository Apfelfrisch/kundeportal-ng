# Basis-URL der Laravel-API (ohne /api). Im Simulator/Emulator die IP des Rechners
# statt localhost verwenden, z. B. http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Mandant (Slug wie CLIENT der API) – wählt den Farbsatz unter src/theme/tenants.
EXPO_PUBLIC_CLIENT=friesen-werk
